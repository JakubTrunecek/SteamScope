{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steamscope-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173"
  },
  "env": {
    "production": {
      "vars": {
        "ALLOWED_ORIGIN": "https://jakubtrunecek.github.io"
      }
    }
  }
}
